# --- secrets & local config: never commit ---
.env
.env.*
!.env.example
*.env
.secrets
.secrets.*
*.pem
*.key
*.p12
*.pfx
*.jwk
id_rsa
id_ed25519
*_rsa
*_ed25519
credentials
credentials.json
token.json
.oauth.json*
.netrc
.npmrc
.pypirc
.aws/
.gcloud/
.azure/
.sops.yaml
*.tfvars
*.tfstate
*.tfstate.backup

# --- run artifacts / generated output ---
# One run is published so a fresh clone has something real to look at in the
# viewer (see "A published example" in README.md). Only its two record files:
# the per-attempt workspaces stay out. `engine serve` rebuilds index.json.
/runs/*
!/runs/opencode-default/
/runs/opencode-default/*
!/runs/opencode-default/run.json
!/runs/opencode-default/events.jsonl
out/
dist/
build/
*.log
!stages/**/*.log
*.sqlite
*.db
sandbox/
.cache/
tmp/

